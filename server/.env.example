PORT=3001

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=uni-nexus

JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=8h

CLIENT_URL=http://localhost:5173

# Local filesystem storage. UPLOAD_DIR is retained only as a deprecated alias.
STORAGE_DRIVER=local
STORAGE_DIR=uploads
STORAGE_PUBLIC_BASE_URL=/uploads
UPLOAD_DIR=uploads
NODE_ENV=development
BOOTSTRAP_CTO_EMAIL=m.taqizdihar@gmail.com

# Base64-encoded 32-byte AES-256-GCM key for the Integration credential vault.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never commit a real value. Secret operations fail closed when this is unset.
INTEGRATION_SECRET_KEY=
