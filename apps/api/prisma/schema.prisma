generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model audit_logs {
  id             BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  workspace_id   BigInt?     @db.UnsignedBigInt
  user_id        BigInt?     @db.UnsignedBigInt
  action         String      @db.VarChar(100)
  entity_type    String      @db.VarChar(100)
  entity_id      BigInt?     @db.UnsignedBigInt
  old_value_json Json?
  new_value_json Json?
  ip_address     String?     @db.VarChar(45)
  user_agent     String?     @db.VarChar(500)
  created_at     DateTime    @default(now()) @db.DateTime(0)
  workspaces     workspaces? @relation(fields: [workspace_id], references: [id], map: "audit_logs_ibfk_1")
  users          users?      @relation(fields: [user_id], references: [id], map: "audit_logs_ibfk_2")

  @@index([entity_type, entity_id], map: "idx_audit_logs_entity")
  @@index([user_id, created_at], map: "idx_audit_logs_user")
  @@index([workspace_id, created_at], map: "idx_audit_logs_workspace")
}

model cost_components {
  id                BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  workspace_id      BigInt             @db.UnsignedBigInt
  name              String             @db.VarChar(120)
  code              String?            @db.VarChar(60)
  category          String             @db.VarChar(60)
  calculation_type  String             @default("MANUAL") @db.VarChar(50)
  default_unit      String?            @db.VarChar(40)
  default_unit_cost Decimal?           @db.Decimal(14, 4)
  description       String?            @db.Text
  is_active         Boolean            @default(true)
  created_at        DateTime           @default(now()) @db.DateTime(0)
  updated_at        DateTime           @default(now()) @db.DateTime(0)
  workspaces        workspaces         @relation(fields: [workspace_id], references: [id], onDelete: Cascade, map: "cost_components_ibfk_1")
  production_costs  production_costs[]

  @@unique([workspace_id, code], map: "uq_cost_components_code")
  @@index([workspace_id, category], map: "idx_cost_components_category")
}

model custom_requests {
  id                                                BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  workspace_id                                      BigInt                @db.UnsignedBigInt
  request_number                                    String?               @db.VarChar(60)
  customer_id                                       BigInt                @db.UnsignedBigInt
  source                                            String                @default("CUSTOMER_APP") @db.VarChar(60)
  existing_product_id                               BigInt?               @db.UnsignedBigInt
  title                                             String?               @db.VarChar(180)
  description                                       String?               @db.Text
  requested_quantity                                Int                   @default(1) @db.UnsignedInt
  requested_height_mm                               Decimal?              @db.Decimal(10, 2)
  requested_width_mm                                Decimal?              @db.Decimal(10, 2)
  requested_length_mm                               Decimal?              @db.Decimal(10, 2)
  preferred_material_id                             BigInt?               @db.UnsignedBigInt
  preferred_color                                   String?               @db.VarChar(100)
  target_date                                       DateTime?             @db.Date
  status                                            String                @default("NEW") @db.VarChar(40)
  assigned_designer_id                              BigInt?               @db.UnsignedBigInt
  created_by_user_id                                BigInt?               @db.UnsignedBigInt
  created_at                                        DateTime              @default(now()) @db.DateTime(0)
  updated_at                                        DateTime              @default(now()) @db.DateTime(0)
  workspaces                                        workspaces            @relation(fields: [workspace_id], references: [id], onDelete: Cascade, map: "custom_requests_ibfk_1")
  customers                                         customers             @relation(fields: [customer_id], references: [id], map: "custom_requests_ibfk_2")
  products                                          products?             @relation(fields: [existing_product_id], references: [id], map: "custom_requests_ibfk_3")
  materials                                         materials?            @relation(fields: [preferred_material_id], references: [id], map: "custom_requests_ibfk_4")
  users_custom_requests_assigned_designer_idTousers users?                @relation("custom_requests_assigned_designer_idTousers", fields: [assigned_designer_id], references: [id], map: "custom_requests_ibfk_5")
  users_custom_requests_created_by_user_idTousers   users?                @relation("custom_requests_created_by_user_idTousers", fields: [created_by_user_id], references: [id], map: "custom_requests_ibfk_6")
  design_assets                                     design_assets[]
  design_tasks                                      design_tasks[]
  guest_access_tokens                               guest_access_tokens[]
  ip_reviews                                        ip_reviews[]
  orders                                            orders[]
  quotations                                        quotations[]
  request_files                                     request_files[]
  request_notes                                     request_notes[]

  @@unique([workspace_id, request_number], map: "uq_custom_requests_number")
  @@index([created_by_user_id], map: "created_by_user_id")
  @@index([existing_product_id], map: "existing_product_id")
  @@index([customer_id], map: "idx_custom_requests_customer")
  @@index([assigned_designer_id], map: "idx_custom_requests_designer")
  @@index([workspace_id, status], map: "idx_custom_requests_status")
  @@index([preferred_material_id], map: "preferred_material_id")
}

model customer_accounts {
  id                BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  customer_id       BigInt          @unique(map: "uq_customer_accounts_customer") @db.UnsignedBigInt
  email             String          @unique(map: "uq_customer_accounts_email") @db.VarChar(190)
  password_hash     String          @db.VarChar(255)
  email_verified_at DateTime?       @db.DateTime(0)
  last_login_at     DateTime?       @db.DateTime(0)
  is_active         Boolean         @default(true)
  created_at        DateTime        @default(now()) @db.DateTime(0)
  updated_at        DateTime        @default(now()) @db.DateTime(0)
  customers         customers       @relation(fields: [customer_id], references: [id], onDelete: Cascade, map: "customer_accounts_ibfk_1")
  request_files     request_files[]
  request_notes     request_notes[]
}

model customers {
  id                  BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  customer_code       String?               @unique(map: "uq_customers_code") @db.VarChar(60)
  full_name           String                @db.VarChar(150)
  email               String?               @db.VarChar(190)
  phone               String?               @db.VarChar(30)
  address_text        String?               @db.Text
  notes               String?               @db.Text
  is_active           Boolean               @default(true)
  created_at          DateTime              @default(now()) @db.DateTime(0)
  updated_at          DateTime              @default(now()) @db.DateTime(0)
  custom_requests     custom_requests[]
  customer_accounts   customer_accounts?
  guest_access_tokens guest_access_tokens[]
  orders              orders[]
  quotations          quotations[]

  @@index([email], map: "idx_customers_email")
  @@index([full_name], map: "idx_customers_name")
  @@index([phone], map: "idx_customers_phone")
}

model design_assets {
  id                  BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  workspace_id        BigInt            @db.UnsignedBigInt
  custom_request_id   BigInt?           @db.UnsignedBigInt
  design_task_id      BigInt?           @db.UnsignedBigInt
  file_name           String            @db.VarChar(255)
  asset_type          String            @db.VarChar(50)
  mime_type           String?           @db.VarChar(120)
  file_size_bytes     BigInt?           @db.UnsignedBigInt
  storage_provider    String?           @db.VarChar(40)
  bucket_name         String?           @db.VarChar(120)
  object_key          String?           @db.VarChar(500)
  external_url        String?           @db.Text
  version_label       String?           @db.VarChar(60)
  is_final            Boolean           @default(false)
  uploaded_by_user_id BigInt?           @db.UnsignedBigInt
  notes               String?           @db.Text
  created_at          DateTime          @default(now()) @db.DateTime(0)
  workspaces          workspaces        @relation(fields: [workspace_id], references: [id], onDelete: Cascade, map: "design_assets_ibfk_1")
  custom_requests     custom_requests?  @relation(fields: [custom_request_id], references: [id], map: "design_assets_ibfk_2")
  design_tasks        design_tasks?     @relation(fields: [design_task_id], references: [id], map: "design_assets_ibfk_3")
  users               users?            @relation(fields: [uploaded_by_user_id], references: [id], map: "design_assets_ibfk_4")
  order_items         order_items[]
  product_assets      product_assets[]
  slicing_results     slicing_results[]

  @@index([custom_request_id], map: "idx_design_assets_request")
  @@index([design_task_id], map: "idx_design_assets_task")
  @@index([uploaded_by_user_id], map: "uploaded_by_user_id")
  @@index([workspace_id], map: "workspace_id")
}

model design_tasks {
  id                  BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  workspace_id        BigInt          @db.UnsignedBigInt
  custom_request_id   BigInt          @db.UnsignedBigInt
  assigned_to_user_id BigInt?         @db.UnsignedBigInt
  status              String          @default("PENDING") @db.VarChar(40)
  priority            String          @default("NORMAL") @db.VarChar(20)
  started_at          DateTime?       @db.DateTime(0)
  completed_at        DateTime?       @db.DateTime(0)
  notes               String?         @db.Text
  created_at          DateTime        @default(now()) @db.DateTime(0)
  updated_at          DateTime        @default(now()) @db.DateTime(0)
  design_assets       design_assets[]
  workspaces          workspaces      @relation(fields: [workspace_id], references: [id], onDelete: Cascade, map: "design_tasks_ibfk_1")
  custom_requests     custom_requests @relation(fields: [custom_request_id], references: [id], onDelete: Cascade, map: "design_tasks_ibfk_2")
  users               users?          @relation(fields: [assigned_to_user_id], references: [id], map: "design_tasks_ibfk_3")

  @@index([assigned_to_user_id, status], map: "idx_design_tasks_assignee")
  @@index([custom_request_id], map: "idx_design_tasks_request")
  @@index([workspace_id], map: "workspace_id")
}

model experiment_measurements {
  id              BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  experiment_id   BigInt      @db.UnsignedBigInt
  parameter_name  String      @db.VarChar(120)
  parameter_value String?     @db.VarChar(255)
  unit            String?     @db.VarChar(60)
  created_at      DateTime    @default(now()) @db.DateTime(0)
  experiments     experiments @relation(fields: [experiment_id], references: [id], onDelete: Cascade, map: "experiment_measurements_ibfk_1")

  @@index([experiment_id], map: "idx_experiment_measurements_experiment")
}

model experiments {
  id                      BigInt                    @id @default(autoincrement()) @db.UnsignedBigInt
  workspace_id            BigInt                    @db.UnsignedBigInt
  experiment_number       String?                   @db.VarChar(60)
  title                   String                    @db.VarChar(180)
  printer_id              BigInt?                   @db.UnsignedBigInt
  material_id             BigInt?                   @db.UnsignedBigInt
  print_profile_id        BigInt?                   @db.UnsignedBigInt
  objective               String?                   @db.Text
  result_summary          String?                   @db.Text
  result_status           String?                   @db.VarChar(40)
  notes                   String?                   @db.Text
  performed_by_user_id    BigInt?                   @db.UnsignedBigInt
  performed_at            DateTime?                 @db.DateTime(0)
  created_at              DateTime                  @default(now()) @db.DateTime(0)
  updated_at              DateTime                  @default(now()) @db.DateTime(0)
  experiment_measurements experiment_measurements[]
  workspaces              workspaces                @relation(fields: [workspace_id], references: [id], onDelete: Cascade, map: "experiments_ibfk_1")
  printers                printers?                 @relation(fields: [printer_id], references: [id], map: "experiments_ibfk_2")
  materials               materials?                @relation(fields: [material_id], references: [id], map: "experiments_ibfk_3")
  print_profiles          print_profiles?           @relation(fields: [print_profile_id], references: [id], map: "experiments_ibfk_4")
  users                   users?                    @relation(fields: [performed_by_user_id], references: [id], map: "experiments_ibfk_5")

  @@unique([workspace_id, experiment_number], map: "uq_experiments_number")
  @@index([material_id], map: "idx_experiments_material")
  @@index([printer_id], map: "idx_experiments_printer")
  @@index([performed_by_user_id], map: "performed_by_user_id")
  @@index([print_profile_id], map: "print_profile_id")
}

model filament_spools {
  id                    BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  workspace_id          BigInt            @db.UnsignedBigInt
  material_id           BigInt            @db.UnsignedBigInt
  spool_code            String?           @db.VarChar(60)
  brand                 String?           @db.VarChar(120)
  color_name            String?           @db.VarChar(100)
  color_hex             String?           @db.VarChar(10)
  batch_number          String?           @db.VarChar(100)
  initial_weight_gram   Decimal           @default(0.000) @db.Decimal(12, 3)
  remaining_weight_gram Decimal           @default(0.000) @db.Decimal(12, 3)
  purchase_price        Decimal           @default(0.00) @db.Decimal(14, 2)
  cost_per_gram         Decimal           @default(0.0000) @db.Decimal(14, 4)
  purchased_at          DateTime?         @db.DateTime(0)
  status                String            @default("AVAILABLE") @db.VarChar(30)
  notes                 String?           @db.Text
  created_at            DateTime          @default(now()) @db.DateTime(0)
  updated_at            DateTime          @default(now()) @db.DateTime(0)
  workspaces            workspaces        @relation(fields: [workspace_id], references: [id], onDelete: Cascade, map: "filament_spools_ibfk_1")
  materials             materials         @relation(fields: [material_id], references: [id], map: "filament_spools_ibfk_2")
  material_usages       material_usages[]

  @@unique([workspace_id, spool_code], map: "uq_filament_spools_code")
  @@index([material_id], map: "idx_filament_spools_material")
  @@index([workspace_id, status], map: "idx_filament_spools_status")
}

model guest_access_tokens {
  id                BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  customer_id       BigInt           @db.UnsignedBigInt
  custom_request_id BigInt?          @db.UnsignedBigInt
  order_id          BigInt?          @db.UnsignedBigInt
  token_hash        String           @unique(map: "uq_guest_access_token_hash") @db.VarChar(255)
  expires_at        DateTime?        @db.DateTime(0)
  revoked_at        DateTime?        @db.DateTime(0)
  last_used_at      DateTime?        @db.DateTime(0)
  created_at        DateTime         @default(now()) @db.DateTime(0)
  customers         customers        @relation(fields: [customer_id], references: [id], onDelete: Cascade, map: "guest_access_tokens_ibfk_1")
  custom_requests   custom_requests? @relation(fields: [custom_request_id], references: [id], onDelete: Cascade, map: "guest_access_tokens_ibfk_2")
  orders            orders?          @relation(fields: [order_id], references: [id], onDelete: Cascade, map: "guest_access_tokens_ibfk_3")

  @@index([customer_id], map: "idx_guest_access_customer")
  @@index([order_id], map: "idx_guest_access_order")
  @@index([custom_request_id], map: "idx_guest_access_request")
}

model ip_review_checklists {
  id           BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  ip_review_id BigInt     @db.UnsignedBigInt
  check_type   String     @db.VarChar(100)
  result       String?    @db.VarChar(30)
  notes        String?    @db.Text
  created_at   DateTime   @default(now()) @db.DateTime(0)
  ip_reviews   ip_reviews @relation(fields: [ip_review_id], references: [id], onDelete: Cascade, map: "ip_review_checklists_ibfk_1")

  @@index([ip_review_id], map: "idx_ip_review_checklists_review")
}

model ip_reviews {
  id                   BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  workspace_id         BigInt                 @db.UnsignedBigInt
  custom_request_id    BigInt?                @db.UnsignedBigInt
  order_id             BigInt?                @db.UnsignedBigInt
  status               String                 @default("NEEDS_REVIEW") @db.VarChar(30)
  reviewed_by_user_id  BigInt?                @db.UnsignedBigInt
  reviewed_at          DateTime?              @db.DateTime(0)
  notes                String?                @db.Text
  created_at           DateTime               @default(now()) @db.DateTime(0)
  updated_at           DateTime               @default(now()) @db.DateTime(0)
  ip_review_checklists ip_review_checklists[]
  workspaces           workspaces             @relation(fields: [workspace_id], references: [id], onDelete: Cascade, map: "ip_reviews_ibfk_1")
  custom_requests      custom_requests?       @relation(fields: [custom_request_id], references: [id], onDelete: Cascade, map: "ip_reviews_ibfk_2")
  orders               orders?                @relation(fields: [order_id], references: [id], onDelete: Cascade, map: "ip_reviews_ibfk_3")
  users                users?                 @relation(fields: [reviewed_by_user_id], references: [id], map: "ip_reviews_ibfk_4")

  @@index([order_id], map: "idx_ip_reviews_order")
  @@index([custom_request_id], map: "idx_ip_reviews_request")
  @@index([workspace_id, status], map: "idx_ip_reviews_status")
  @@index([reviewed_by_user_id], map: "reviewed_by_user_id")
}

model material_usages {
  id                  BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  workspace_id        BigInt          @db.UnsignedBigInt
  print_job_id        BigInt          @db.UnsignedBigInt
  filament_spool_id   BigInt          @db.UnsignedBigInt
  usage_type          String          @db.VarChar(40)
  weight_gram         Decimal         @default(0.000) @db.Decimal(12, 3)
  cost_per_gram       Decimal         @default(0.0000) @db.Decimal(14, 4)
  total_cost          Decimal         @default(0.00) @db.Decimal(14, 2)
  recorded_by_user_id BigInt?         @db.UnsignedBigInt
  notes               String?         @db.Text
  created_at          DateTime        @default(now()) @db.DateTime(0)
  workspaces          workspaces      @relation(fields: [workspace_id], references: [id], onDelete: Cascade, map: "material_usages_ibfk_1")
  print_jobs          print_jobs      @relation(fields: [print_job_id], references: [id], onDelete: Cascade, map: "material_usages_ibfk_2")
  filament_spools     filament_spools @relation(fields: [filament_spool_id], references: [id], map: "material_usages_ibfk_3")
  users               users?          @relation(fields: [recorded_by_user_id], references: [id], map: "material_usages_ibfk_4")

  @@index([print_job_id], map: "idx_material_usages_print_job")
  @@index([filament_spool_id], map: "idx_material_usages_spool")
  @@index([workspace_id, usage_type], map: "idx_material_usages_type")
  @@index([recorded_by_user_id], map: "recorded_by_user_id")
}

model materials {
  id               BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  workspace_id     BigInt             @db.UnsignedBigInt
  name             String             @db.VarChar(120)
  material_type    String             @db.VarChar(60)
  manufacturer     String?            @db.VarChar(120)
  description      String?            @db.Text
  is_active        Boolean            @default(true)
  created_at       DateTime           @default(now()) @db.DateTime(0)
  updated_at       DateTime           @default(now()) @db.DateTime(0)
  custom_requests  custom_requests[]
  experiments      experiments[]
  filament_spools  filament_spools[]
  workspaces       workspaces         @relation(fields: [workspace_id], references: [id], onDelete: Cascade, map: "materials_ibfk_1")
  pricing_rules    pricing_rules[]
  print_profiles   print_profiles[]
  product_variants product_variants[]
  products         products[]
  quotation_items  quotation_items[]

  @@index([workspace_id, material_type], map: "idx_materials_workspace_type")
}

model notification_settings {
  id           BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  workspace_id BigInt     @db.UnsignedBigInt
  event_key    String     @db.VarChar(100)
  channel      String     @db.VarChar(40)
  destination  String?    @db.VarChar(190)
  provider     String?    @db.VarChar(80)
  is_enabled   Boolean    @default(false)
  config_json  Json?
  created_at   DateTime   @default(now()) @db.DateTime(0)
  updated_at   DateTime   @default(now()) @db.DateTime(0)
  workspaces   workspaces @relation(fields: [workspace_id], references: [id], onDelete: Cascade, map: "notification_settings_ibfk_1")

  @@unique([workspace_id, event_key, channel], map: "uq_notification_settings")
}

model notifications {
  id                BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  workspace_id      BigInt     @db.UnsignedBigInt
  recipient_user_id BigInt     @db.UnsignedBigInt
  event_type        String     @db.VarChar(100)
  entity_type       String?    @db.VarChar(80)
  entity_id         BigInt?    @db.UnsignedBigInt
  title             String     @db.VarChar(190)
  message           String?    @db.Text
  read_at           DateTime?  @db.DateTime(0)
  created_at        DateTime   @default(now()) @db.DateTime(0)
  workspaces        workspaces @relation(fields: [workspace_id], references: [id], onDelete: Cascade, map: "notifications_ibfk_1")
  users             users      @relation(fields: [recipient_user_id], references: [id], onDelete: Cascade, map: "notifications_ibfk_2")

  @@index([recipient_user_id, read_at], map: "idx_notifications_recipient")
  @@index([workspace_id, event_type], map: "idx_notifications_workspace_event")
}

model order_items {
  id                 BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  order_id           BigInt            @db.UnsignedBigInt
  product_id         BigInt?           @db.UnsignedBigInt
  product_variant_id BigInt?           @db.UnsignedBigInt
  design_asset_id    BigInt?           @db.UnsignedBigInt
  item_name          String            @db.VarChar(180)
  description        String?           @db.Text
  quantity           Int               @default(1) @db.UnsignedInt
  unit_price         Decimal           @default(0.00) @db.Decimal(14, 2)
  total_price        Decimal           @default(0.00) @db.Decimal(14, 2)
  created_at         DateTime          @default(now()) @db.DateTime(0)
  updated_at         DateTime          @default(now()) @db.DateTime(0)
  orders             orders            @relation(fields: [order_id], references: [id], onDelete: Cascade, map: "order_items_ibfk_1")
  products           products?         @relation(fields: [product_id], references: [id], map: "order_items_ibfk_2")
  product_variants   product_variants? @relation(fields: [product_variant_id], references: [id], map: "order_items_ibfk_3")
  design_assets      design_assets?    @relation(fields: [design_asset_id], references: [id], map: "order_items_ibfk_4")
  production_jobs    production_jobs[]

  @@index([design_asset_id], map: "design_asset_id")
  @@index([order_id], map: "idx_order_items_order")
  @@index([product_id], map: "product_id")
  @@index([product_variant_id], map: "product_variant_id")
}

model order_packaging {
  id                BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  workspace_id      BigInt          @db.UnsignedBigInt
  order_id          BigInt          @db.UnsignedBigInt
  packaging_type_id BigInt          @db.UnsignedBigInt
  quantity          Int             @default(1) @db.UnsignedInt
  actual_cost       Decimal         @default(0.00) @db.Decimal(14, 2)
  status            String          @default("PENDING") @db.VarChar(30)
  packed_by_user_id BigInt?         @db.UnsignedBigInt
  packed_at         DateTime?       @db.DateTime(0)
  notes             String?         @db.Text
  created_at        DateTime        @default(now()) @db.DateTime(0)
  updated_at        DateTime        @default(now()) @db.DateTime(0)
  workspaces        workspaces      @relation(fields: [workspace_id], references: [id], onDelete: Cascade, map: "order_packaging_ibfk_1")
  orders            orders          @relation(fields: [order_id], references: [id], onDelete: Cascade, map: "order_packaging_ibfk_2")
  packaging_types   packaging_types @relation(fields: [packaging_type_id], references: [id], map: "order_packaging_ibfk_3")
